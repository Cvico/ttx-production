import model loop_sm-no_b_mass

define ell+ = e+ mu+ ta+
define ell- = e- mu- ta-
define vll = ve vm vt
define vll~ = ve~ vm~ vt~

generate p p > t t~ ell+ vll [QCD]
add process p p > t t~ ell+ vll j [QCD]
add process p p > t t~ ell- vll~ [QCD] 
add process p p > t t~ ell- vll~ j [QCD]

output TTLNu-1Jets_amcatnloFXFX-pythia8